# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet or backend is hosted (e.g., https://usem-nnyin.vercel.app)
APP_URL="https://usem-nnyin.vercel.app"

# VITE_API_URL: Optional custom backend base URL if frontend is hosted separately from Express backend
VITE_API_URL=""

# Firebase Client Configuration (Populate from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="YOUR_FIREBASE_OAUTH_CLIENT_ID"
